# ------------------------------------------------------------
# J-Creator AI Sync — local environment variables
#
# Copy this file to `.env.local` and fill in the values from your
# Supabase / OpenAI dashboards. Do NOT commit `.env.local`.
# ------------------------------------------------------------

# Supabase (Phase 2)
# https://app.supabase.com/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Optional: only required on the server side for admin-level operations.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# OpenAI (Phase 3 以降)
OPENAI_API_KEY="sk-..."

# Anthropic (Phase 4 以降、使う場合)
ANTHROPIC_API_KEY="sk-ant-..."
